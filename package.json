{
  "name": "cemp-mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "node tools/audit-deps/audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.11",
      "body-parser@1": "1.20.9",
      "browserslist": "4.29.0",
      "compression": "1.8.2",
      "image-size": "2.0.4",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "launch-editor": "2.14.2",
      "nanoid@3": "3.3.18",
      "shell-quote": "1.11.0"
    },
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch",
      "metro@0.83.7": "patches/metro@0.83.7.patch"
    },
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
